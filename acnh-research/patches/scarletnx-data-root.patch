+#include "renderdoc_app.h"
+static RENDERDOC_API_1_6_0* g_rdoc;
+static unsigned g_capture_frame;
+static int g_capture_done;
+static void capture_begin(void) {
+    const char* frame = getenv("SNX_RENDERDOC_FRAME");
+    if (!frame || g_capture_done) return;
+    if (!g_rdoc) {
+        void* library = plat_dl_open("renderdoc.dll");
+        pRENDERDOC_GetAPI get_api = library ? (pRENDERDOC_GetAPI)plat_dl_sym(library, "RENDERDOC_GetAPI") : NULL;
+        if (!get_api || !get_api(eRENDERDOC_API_Version_1_6_0, (void**)&g_rdoc)) {
+            LOG("RenderDoc capture API unavailable\n");
+            g_capture_done = 1;
+            return;
+        }
+        const char* output = getenv("SNX_RENDERDOC_OUTPUT");
+        if (output) g_rdoc->SetCaptureFilePathTemplate(output);
+        g_capture_frame = (unsigned)strtoul(frame, NULL, 10);
+    }
+    if (g_vk_present == g_capture_frame) {
+        g_rdoc->StartFrameCapture((RENDERDOC_DevicePointer)g_vk.instance, NULL);
+        LOG("RenderDoc capture begins at present %u\n", g_capture_frame);
+    }
+}
+static void capture_end(void) {
+    if (g_rdoc && !g_capture_done && g_vk_present == g_capture_frame + 2) {
+        unsigned result = g_rdoc->EndFrameCapture((RENDERDOC_DevicePointer)g_vk.instance, NULL);
+        LOG("RenderDoc capture finished: %u\n", result);
+        g_capture_done = 1;
+    }
+}
+#endif
