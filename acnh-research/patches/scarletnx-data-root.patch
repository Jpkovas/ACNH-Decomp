diff --git a/tests/report_semaphore.c b/tests/report_semaphore.c
new file mode 100644
index 0000000..9f38763
--- /dev/null
+++ b/tests/report_semaphore.c
@@ -0,0 +1,148 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* Exercise the production report semaphore handler without a renderer or game data. Expected structure sizes
+   follow NVIDIA's Maxwell B class header, not the handler's release-ordering implementation:
+   https://github.com/NVIDIA/open-gpu-doc/blob/master/classes/3d/clb197.h */
+#include "gpu/engines_int.h"
+#include <stdarg.h>
+
+static u8 memory[64];
+static u64 clock_ns;
+static u32 signals, writes, last_size;
+static unsigned checks;
+int g_verbose;
+u64 g_draws;
+const Renderer* g_renderer;
+
+static void test_fail(const char* expr, int line) {
+    fprintf(stderr, "report_semaphore.c:%d: %s\n", line, expr);
+    exit(1);
+}
+#define CHECK(expr)                                                                                                    \
+    do {                                                                                                               \
+        checks++;                                                                                                      \
+        if (!(expr)) test_fail(#expr, __LINE__);                                                                       \
+    } while (0)
+
+u64 guest_ns(void) { return clock_ns += 1000; }
+u64 plat_ns(void) { return clock_ns; }
+void plat_yield(void) { test_fail("unexpected wait", __LINE__); }
+void gpu_signal_point(void) { signals++; }
+int gmem_write(u64 addr, const void* src, u64 size) {
+    CHECK(addr <= sizeof memory && size <= sizeof memory - addr);
+    memcpy(memory + addr, src, (size_t)size);
+    writes++;
+    last_size = (u32)size;
+    return 0;
+}
+void gmem_w32(u64 addr, u32 value) { gmem_write(addr, &value, sizeof value); }
+u32 gmem_r32(u64 addr) {
+    CHECK(addr <= sizeof memory - 4);
+    u32 value;
+    memcpy(&value, memory + addr, 4);
+    return value;
+}
+void logf_(int level, const char* fmt, ...) {
+    (void)level;
+    (void)fmt;
+}
+void fatal(const char* fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+    abort();
+}
+/* Other methods in engines.c are linked, but reaching them would invalidate this isolated fixture. */
+void r3d_draw(GpuChannel* ch, int indexed, u32 topology, u32 first, u32 count, u32 base_vertex, u32 base_instance,
+              u32 instances) {
+    (void)ch;
+    (void)indexed;
+    (void)topology;
+    (void)first;
+    (void)count;
+    (void)base_vertex;
+    (void)base_instance;
+    (void)instances;
+    test_fail("unexpected draw", __LINE__);
+}
+void r3d_const_flush(GpuChannel* ch) {
+    (void)ch;
+    test_fail("unexpected constant flush", __LINE__);
+}
+void r3d_const_upload(GpuChannel* ch, u32 value, int last) {
+    (void)ch;
+    (void)value;
+    (void)last;
+    test_fail("unexpected constant upload", __LINE__);
+}
+void r3d_cb_bind(GpuChannel* ch, int stage, u32 value) {
+    (void)ch;
+    (void)stage;
+    (void)value;
+    test_fail("unexpected constant bind", __LINE__);
+}
+void r3d_clear(GpuChannel* ch, u32 value) {
+    (void)ch;
+    (void)value;
+    test_fail("unexpected clear", __LINE__);
+}
+void mme_run(GpuChannel* ch, u32 index, const u32* params, u32 count) {
+    (void)ch;
+    (void)index;
+    (void)params;
+    (void)count;
+    test_fail("unexpected macro", __LINE__);
+}
+void i2m_launch(GpuChannel* ch, u32* regs, int base) {
+    (void)ch;
+    (void)regs;
+    (void)base;
+    test_fail("unexpected inline launch", __LINE__);
+}
+void i2m_data(GpuChannel* ch, u32 value) {
+    (void)ch;
+    (void)value;
+    test_fail("unexpected inline data", __LINE__);
+}
+
+static void verify_write(GpuChannel* channel, u32 argument, u32 payload, int one_word, int counter) {
+    u32* regs = channel->r3d;
+    regs[0x6C0] = 0;
+    regs[0x6C1] = 16;
+    regs[0x6C2] = payload;
+    memset(memory, 0xA5, sizeof memory);
+    signals = writes = last_size = 0;
+    query_get(channel, regs, 0x6C0, argument);
+    CHECK(signals == 1);
+    CHECK(writes == 1);
+    CHECK(last_size == (one_word ? 4u : 16u));
+    u32 low;
+    memcpy(&low, memory + 16, sizeof low);
+    CHECK(low == (counter ? 0 : payload));
+    if (!one_word) {
+        u32 high;
+        u64 timestamp;
+        memcpy(&high, memory + 20, sizeof high);
+        memcpy(&timestamp, memory + 24, sizeof timestamp);
+        CHECK(high == 0);
+        CHECK(timestamp == clock_ns * 384 / 625);
+        CHECK(timestamp > 0);
+    }
+    for (u32 i = 0; i < sizeof memory; i++)
+        if (i < 16 || i >= (one_word ? 20u : 32u)) CHECK(memory[i] == 0xA5);
+}
+
+int main(void) {
+    GpuChannel channel = {0};
+    const u32 payloads[2] = {0, 0xFFEEDDCC};
+    for (u32 order = 0; order < 2; order++)
+        for (u32 one_word = 0; one_word < 2; one_word++)
+            for (u32 payload = 0; payload < 2; payload++)
+                verify_write(&channel, (order << 4) | (one_word << 28), payloads[payload], (int)one_word, 0);
+    /* REPORT_NONE carries a timestamp with the same independently selected structure size. */
+    for (u32 one_word = 0; one_word < 2; one_word++)
+        verify_write(&channel, 2 | (one_word << 28), 0xFFEEDDCC, (int)one_word, 1);
+    printf("report_semaphore: 10 cases, %u checks passed\n", checks);
+    return 0;
+}
