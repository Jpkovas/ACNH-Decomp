+            g_capture_done = 1;
+            g_capture_unavailable = 1;
+            return;
+        }
+        const char* output = getenv("SNX_RENDERDOC_OUTPUT");
+        if (output) g_rdoc->SetCaptureFilePathTemplate(output);
+        g_capture_frame = frame ? (unsigned)strtoul(frame, NULL, 10) : 0;
+    }
+    int requested = frame && !g_capture_done && g_vk_present == g_capture_frame;
