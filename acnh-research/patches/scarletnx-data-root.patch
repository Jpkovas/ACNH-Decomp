+            !check_clear_pixels(s, 0xFF0000FF, 0xFF00FF00, regions[i][0], regions[i][1], regions[i][2], regions[i][3]));
+    }
+    /* Conditional clear compares two zero records in an unmapped range:
+       NOT_EQUAL must retain red, EQUAL must replace it with green. */
+    const u32 modes[] = {0, 4, 3, 1};
+    const u32 overrides[] = {0, 0, 0, 2};
+    for (u32 i = 0; i < 4; i++) {
+        r[0x43E] = 0;
+        r[0x556] = 1;
+        r[0x651] = 0;
+        memcpy(&r[0x360], red, sizeof red);
+        r3d_clear(ch, 0x3C);
+        r[0x556] = modes[i];
+        r[0x651] = overrides[i];
