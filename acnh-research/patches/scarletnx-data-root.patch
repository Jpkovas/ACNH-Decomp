+        g_capture_active = 1;
+        LOG("RenderDoc capture begins at present %u\n", g_capture_frame);
+    }
+}
+static void capture_end(void) {
+    if (g_rdoc && g_capture_active && g_vk_present == g_capture_frame + 2) {
+        unsigned result = g_rdoc->EndFrameCapture((RENDERDOC_DevicePointer)g_vk.instance, NULL);
+        LOG("RenderDoc capture finished: %u\n", result);
+        g_capture_done = 1;
+        g_capture_active = 0;
+    }
