+/* SET_RENDER_ENABLE_C and SET_RENDER_ENABLE_OVERRIDE (Maxwell B). The
+   comparison operands are the sequence/count pairs at bytes 0 and 16;
+   timestamps at bytes 8 and 24 do not participate. */
+static int render_enabled(GpuChannel* ch) {
+    const u32* r = ch->r3d;
+    u32 override = r[0x651] & 3, mode = r[0x556] & 7;
+    if (override == 1) return 1;
+    if (override == 2 || mode == 0) return 0;
+    if (mode == 1) return 1;
+    u64 address = ((u64)(r[0x554] & 0xFF) << 32) | r[0x555];
+    u32 words[8];
+    gmem_read(address, words, sizeof words);
+    int enabled;
+    if (mode == 2) enabled = words[0] != 0 && words[1] != 0;
+    else if (mode == 3 || mode == 4) {
+        int equal = words[0] == words[4] && words[1] == words[5];
+        enabled = mode == 3 ? equal : !equal;
+    } else {
+        WARN_LIMIT(1, "gpu: unknown conditional render mode %u\n", mode);
+        return 1;
+    }
+    if (getenv("SNX_CONDITION_TRACE")) {
+        static u32 traces;
+        if (traces++ < 24)
+            LOG("ACNH condition trace: mode=%u address=%llx initial=%08x,%08x current=%08x,%08x enabled=%d\n",
+                mode, (unsigned long long)address, words[0], words[1], words[4], words[5], enabled);
+    }
+    return enabled;
+}
