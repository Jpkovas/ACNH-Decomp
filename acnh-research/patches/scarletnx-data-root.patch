+    const u32 controls[] = {0x10, 0x100, 0x1110, 0x110};
+    for (u32 i = 0; i < 4; i++) {
+        r[0x43E] = 0;
+        memcpy(&r[0x360], red, sizeof red);
+        r3d_clear(ch, 0x3C);
+        r[0x43E] = controls[i];
+        r[0x380] = 1;
+        r[0x35B] = 4 | (20 << 16);
+        r[0x35C] = 2 | (10 << 16);
+        r[0x381] = 8 | (24 << 16);
+        r[0x382] = 4 | (12 << 16);
+        r[0x300] = 10 | (8 << 16);
+        r[0x301] = 5 | (3 << 16);
+        if (i == 3) r[0x35B] = 4 | (4 << 16); /* empty clear */
