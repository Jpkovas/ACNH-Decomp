diff --git a/runtime/hle/audren.c b/runtime/hle/audren.c
index c02e9ba..7e03387 100644
--- a/runtime/hle/audren.c
+++ b/runtime/hle/audren.c
@@ -6,0 +7,3 @@
+#ifdef SNX_AUDIO_NATIVE
+#include "native_backend.h"
+#endif
@@ -77,0 +81,88 @@ int audren_update(SvcObj* o, IpcCtx* c) {
+    /* One bounded private snapshot for implementing the DSP/output contract. */
+    const char* capture_dir = getenv("SNX_AUDIO_TRACE_DIR");
+    static u32 initial_captures;
+    if (capture_dir && initial_captures < 64) {
+        char path[1400];
+        snprintf(path, sizeof path, "%s/update-%04u.bin", capture_dir, initial_captures++);
+        FILE* file = fopen(path, "wb");
+        if (file) {
+            fwrite(in, 1, (size_t)is, file);
+            fclose(file);
+        }
+    }
+    static int captured;
+    if (capture_dir && !captured) {
+        int active = 0;
+        for (u32 i = 0; i < vo / 0x170; i++) {
+            const u8* vi = voices_in + i * 0x170;
+            u64 address;
+            memcpy(&address, vi + 0x60, 8);
+            if (vi[9] && vi[0xA] == 0 && address) active++;
+        }
+        if (active) {
+            captured = 1;
+            char path[1400];
+            snprintf(path, sizeof path, "%s/input.bin", capture_dir);
+            FILE* file = fopen(path, "wb");
+            if (file) {
+                fwrite(in, 1, (size_t)is, file);
+                fclose(file);
+            }
+            snprintf(path, sizeof path, "%s/profile.txt", capture_dir);
+            file = fopen(path, "w");
+            if (file) {
+                fprintf(file, "revision=%08x sections", rev);
+                for (int i = 1; i < 16; i++) fprintf(file, " %u", ih[i]);
+                fprintf(file, "\n");
+                for (u32 i = 0; i < vo / 0x170; i++) {
+                    const u8* vi = voices_in + i * 0x170;
+                    if (!vi[9] || vi[0xA] != 0) continue;
+                    u32 fields[6];
+                    memcpy(fields, vi + 0xC, sizeof fields);
+                    fprintf(file, "voice=%u format=%u rate=%u channels=%u pitch=%08x volume=%08x\n", i, vi[0xB],
+                            fields[0], fields[3], fields[4], fields[5]);
+                    for (u32 slot = 0; slot < 6; slot++) {
+                        const u8* section = slot < 4 ? vi + 0x60 + slot * 0x38 : vi + 0x48;
+                        u64 address, bytes;
+                        memcpy(&address, section, 8);
+                        memcpy(&bytes, section + 8, 8);
+                        if (slot == 5) {
+                            section = vi + 0x80;
+                            memcpy(&address, section, 8);
+                            memcpy(&bytes, section + 8, 8);
+                        }
+                        if (!address || !bytes || bytes > 2 * 1024 * 1024 || address >= AS_SIZE ||
+                            bytes > AS_SIZE - address)
+                            continue;
+                        u64 remaining = bytes, at = address;
+                        int readable = 1;
+                        while (remaining) {
+                            MemBlock block;
+                            mem_query(at, &block);
+                            if (!(block.perm & PERM_R) || at < block.addr || at >= block.addr + block.size) {
+                                readable = 0;
+                                break;
+                            }
+                            u64 span = block.addr + block.size - at;
+                            if (span > remaining) span = remaining;
+                            remaining -= span;
+                            at += span;
+                        }
+                        if (!readable) continue;
+                        snprintf(path, sizeof path, "%s/%llx-%llu.bin", capture_dir, (unsigned long long)address,
+                                 (unsigned long long)bytes);
+                        FILE* raw = fopen(path, "wb");
+                        if (raw) {
+                            fwrite(GP(address), 1, (size_t)bytes, raw);
+                            fclose(raw);
+                        }
+                    }
+                }
+                fclose(file);
+            }
+            LOG("audren: captured %d active voices for private DSP analysis\n", active);
+        }
+    }
+#ifdef SNX_AUDIO_NATIVE
+    if (audren_native_enabled(o)) return audren_native_update(o, c);
+#endif
