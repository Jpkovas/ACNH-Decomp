+/* Inspect the attachment itself, before presentation, including alpha. */
+static int check_clear_pixels(Surf* s, u32 background, u32 foreground, u32 x0, u32 y0, u32 x1, u32 y1) {
+    VkBuffer buffer;
+    u8* data = vk_readback_buffer((u64)s->w * s->h * 4, &buffer);
+    CHECK(data);
+    VkCommandBuffer cb = vk_cmd();
+    vk_surf_use(cb, s, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+    VkBufferImageCopy copy = {.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {s->w, s->h, 1}};
+    vkCmdCopyImageToBuffer(cb, s->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer, 1, &copy);
+    VkMemoryBarrier2 barrier = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+        .srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT, .srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT,
+        .dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT, .dstAccessMask = VK_ACCESS_2_HOST_READ_BIT};
+    VkDependencyInfo dependency = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+        .memoryBarrierCount = 1, .pMemoryBarriers = &barrier};
+    vkCmdPipelineBarrier2(cb, &dependency);
+    vk_finish();
+    vk_readback_ready();
+    for (u32 y = 0; y < s->h; y++)
+        for (u32 x = 0; x < s->w; x++) {
+            u32 expected = x >= x0 && x < x1 && y >= y0 && y < y1 ? foreground : background;
+            CHECK(((const u32*)data)[y * s->w + x] == expected);
+        }
+    return 0;
+}
+
+static int check_clear_regions(void) {
+    nv_init();
+    GpuChannel* ch = calloc(1, sizeof *ch);
+    CHECK(ch);
+    u32* r = ch->r3d;
+    r[0x487] = 1; /* slot zero */
+    r[0x201] = 0x9000; /* unmapped synthetic surface: no game data */
+    r[0x202] = 32 * 4;
+    r[0x203] = 16;
+    r[0x204] = 0xD5; /* RGBA8 UNORM */
+    r[0x205] = 0x1000; /* pitch linear */
+    r[0x206] = 1;
+    r[0x556] = 1;
+    float red[4] = {1, 0, 0, 1}, green[4] = {0, 1, 0, 1};
+    const u32 controls[] = {0x10, 0x100, 0x1110, 0x110};
+    for (u32 i = 0; i < 4; i++) {
+        r[0x43E] = 0;
+        memcpy(&r[0x360], red, sizeof red);
+        r3d_clear(ch, 0x3C);
+        r[0x43E] = controls[i];
+        r[0x380] = 1;
+        r[0x35B] = 4 | (20 << 16);
+        r[0x35C] = 2 | (10 << 16);
+        r[0x381] = 8 | (24 << 16);
+        r[0x382] = 4 | (12 << 16);
+        r[0x300] = 10 | (8 << 16);
+        r[0x301] = 5 | (3 << 16);
+        if (i == 3) r[0x35B] = 4 | (4 << 16); /* empty clear */
+        memcpy(&r[0x360], green, sizeof green);
+        r3d_clear(ch, 0x3C);
+        Surf* s = vk_rt_find(0x9000);
+        CHECK(s);
+        const u32 regions[4][4] = {{4,2,20,10}, {8,4,24,12}, {10,5,18,8}, {0,0,0,0}};
+        CHECK(!check_clear_pixels(s, 0xFF0000FF, 0xFF00FF00,
+            regions[i][0], regions[i][1], regions[i][2], regions[i][3]));
+    }
+    /* Conditional clear compares two zero records in an unmapped range:
+       NOT_EQUAL must retain red, EQUAL must replace it with green. */
+    const u32 modes[] = {0, 4, 3, 1};
+    const u32 overrides[] = {0, 0, 0, 2};
+    for (u32 i = 0; i < 4; i++) {
+        r[0x43E] = 0;
+        r[0x556] = 1;
+        r[0x651] = 0;
+        memcpy(&r[0x360], red, sizeof red);
+        r3d_clear(ch, 0x3C);
+        r[0x556] = modes[i];
+        r[0x651] = overrides[i];
+        memcpy(&r[0x360], green, sizeof green);
+        r3d_clear(ch, 0x3C);
+        CHECK(!check_clear_pixels(vk_rt_find(0x9000), i == 2 ? 0xFF00FF00 : 0xFF0000FF, 0, 0,0,0,0));
+    }
+    free(ch);
+    return 0;
+}
+
