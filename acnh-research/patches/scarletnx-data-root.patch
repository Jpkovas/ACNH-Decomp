+static void capture_begin(void) {
+    const char* frame = getenv("SNX_RENDERDOC_FRAME");
+    const char* trigger = getenv("SNX_RENDERDOC_TRIGGER");
+    if ((!frame && !trigger) || (g_capture_done && !trigger) || g_capture_active || g_capture_unavailable) return;
+    if (!g_rdoc) {
+        void* library = plat_dl_open("renderdoc.dll");
